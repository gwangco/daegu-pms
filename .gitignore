# Maven 빌드 산출물
target/
# (이전 Gradle 빌드 산출물 - 혹시 남아 있어도 커밋되지 않도록 유지)
.gradle/
build/

# IDE Configurations
.idea/
*.iml
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
.classpath
.project
.settings/
.factorypath
# Eclipse 워크스페이스(프로젝트 폴더를 워크스페이스로 잘못 열었을 때 생김)·Spring Tools 캐시
.metadata/
.sts4-cache/
Servers/
bin/
out/

# Log & Temporary files
*.log
*.tmp
*.bak
logs/

# OS specific files
Thumbs.db
.DS_Store

# 환경변수/비밀값 파일 (DB 비밀번호, API 키 등은 절대 커밋하지 않는다)
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.jks

# 개인 작업 메모·학습 노트 (공개 저장소에 올리지 않음)
PROJECT_CONTEXT.md
LOCAL_*.md
NOTION_*.md
*.local

# 로컬 JDK 배포본 (JDK 는 프로젝트 폴더 밖 ~/.jdks 에 둔다. 실수 방지를 위해 패턴 유지)
oracleJdk-*/
jdk-*/

# 업로드 파일 저장소 (실행 시 생성되는 사용자 첨부파일)
uploads/

# 로컬 DB 접속 정보 (scripts/setup-local-mysql.ps1 이 생성). 예시 파일만 공유한다
/config/*
!/config/dpms-secret.example.yml
