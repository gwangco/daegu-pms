<?xml version="1.0" encoding="UTF-8"?>
<!--
    Log4j2 설정 (전자정부 표준프레임워크 실행환경의 로깅 구현체)
    - 파일명이 log4j2-spring.xml 이면 Spring Boot 가 읽어 application.yml 의 logging.level 도 함께 적용한다
    - 운영에서는 RollingFile 로 파일 보관 기간을 정하고, 개인정보가 로그에 남지 않도록 주의한다
-->
<Configuration status="WARN">
    <Appenders>
        <Console name="console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} %5p [%t] %c{1.} - %m%n" charset="UTF-8"/>
        </Console>
    </Appenders>
    <Loggers>
        <!-- MyBatis Mapper도 이 패키지에 속한다. DEBUG/TRACE는 SQL 인자·결과를 노출하므로 INFO 유지 -->
        <Logger name="kr.go.daegu.pms" level="INFO" additivity="false">
            <AppenderRef ref="console"/>
        </Logger>
        <!-- eGovFrame 실행환경. org.egovframe.boot.crypto 의 DEBUG 는 암호화 평문과 키를 그대로 출력하므로 올리지 않는다 -->
        <Logger name="org.egovframe" level="INFO" additivity="false">
            <AppenderRef ref="console"/>
        </Logger>
        <Logger name="org.springframework" level="INFO" additivity="false">
            <AppenderRef ref="console"/>
        </Logger>
        <Root level="INFO">
            <AppenderRef ref="console"/>
        </Root>
    </Loggers>
</Configuration>
