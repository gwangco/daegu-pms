<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE configuration PUBLIC "-//mybatis.org//DTD Config 3.0//EN" "http://mybatis.org/dtd/mybatis-3-config.dtd">
<!-- MyBatis 전역 설정 (전자정부 표준프레임워크 sql-mapper-config.xml 규칙) -->
<configuration>
    <settings>
        <!-- 쿼리 1건이 이 시간(초)을 넘기면 중단 (무한 대기·과부하 방지) -->
        <setting name="defaultStatementTimeout" value="10"/>
        <!-- DB 컬럼 user_name → Java 필드 userName 자동 매핑 -->
        <setting name="mapUnderscoreToCamelCase" value="true"/>
        <!-- null 파라미터를 JDBC NULL 로 전달 (Oracle 등에서 "부적합한 열 유형" 오류 방지) -->
        <setting name="jdbcTypeForNull" value="NULL"/>
        <setting name="logImpl" value="SLF4J"/>
    </settings>

    <!-- 매퍼 XML 의 resultType/parameterType 에서 짧은 이름으로 쓰기 위한 별칭 (VO 추가 시 여기에 등록) -->
    <typeAliases>
        <typeAlias alias="announcementVO" type="kr.go.daegu.pms.announcement.service.AnnouncementVO"/>
        <typeAlias alias="announcementSearchVO" type="kr.go.daegu.pms.announcement.service.AnnouncementSearchVO"/>
        <typeAlias alias="fieldBudgetStatVO" type="kr.go.daegu.pms.announcement.service.FieldBudgetStatVO"/>
        <typeAlias alias="applicationVO" type="kr.go.daegu.pms.application.service.ApplicationVO"/>
        <typeAlias alias="applicationSearchVO" type="kr.go.daegu.pms.application.service.ApplicationSearchVO"/>
        <typeAlias alias="evaluationVO" type="kr.go.daegu.pms.evaluation.service.EvaluationVO"/>
        <typeAlias alias="settlementVO" type="kr.go.daegu.pms.settlement.service.SettlementVO"/>
        <typeAlias alias="userVO" type="kr.go.daegu.pms.user.service.UserVO"/>
        <typeAlias alias="commonCodeVO" type="kr.go.daegu.pms.cmm.service.CommonCodeVO"/>
        <typeAlias alias="fileVO" type="kr.go.daegu.pms.cmm.service.FileVO"/>
    </typeAliases>
</configuration>
