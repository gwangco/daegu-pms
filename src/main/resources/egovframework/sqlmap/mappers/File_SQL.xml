<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
    첨부파일이 연결된 업무 찾기 (다운로드 권한 판단용).
    첨부파일 정보 자체는 공통컴포넌트 SQL(egovframework/mapper/com/cmm/fms/EgovFile_SQL_mysql.xml)이 다룬다.
-->
<mapper namespace="kr.go.daegu.pms.cmm.service.impl.FileMapper">

    <select id="selectApplicationIdByPlanFile" resultType="long">
        SELECT application_id FROM application WHERE plan_atch_file_id = #{atchFileId}
    </select>

    <select id="selectApplicationIdByReceiptFile" resultType="long">
        SELECT application_id FROM settlement WHERE receipt_atch_file_id = #{atchFileId}
    </select>

</mapper>
