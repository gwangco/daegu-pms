<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="kr.go.daegu.pms.user.service.impl.UserMapper">

    <!-- 비밀번호 해시는 인증 쿼리(selectUserForLogin)에서만 조회한다 -->
    <sql id="userColumns">
            user_id, user_name, email, phone, company_name, business_no, role, enabled, created_at
    </sql>

    <select id="selectUserForLogin" resultType="userVO">
        SELECT
            <include refid="userColumns"/>,
            password
        FROM users
        WHERE user_id = #{userId}
    </select>

    <select id="selectUser" resultType="userVO">
        SELECT
            <include refid="userColumns"/>
        FROM users
        WHERE user_id = #{userId}
    </select>

    <select id="selectUserListByRole" resultType="userVO">
        SELECT
            <include refid="userColumns"/>
        FROM users
        WHERE role = #{role}
        ORDER BY user_name ASC
    </select>

</mapper>
