<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        전자정부 표준프레임워크 Boot 부모 POM (5.1.0).
        - Spring Boot 3.5.16 / Spring Framework 6.2.19 / Spring Security 6.5.11-egov.1 버전을 일괄 관리
        - org.egovframe.rte:egovframe-rte-* 실행환경 모듈 버전(egovframe.rte.version)을 일괄 관리
        - Java 17, 소스 인코딩 UTF-8 기본 설정
        → 개별 라이브러리에 버전을 적지 않아도 eGovFrame 이 검증한 조합으로 맞춰진다.
          보안 패치도 Spring Boot 버전을 따로 올리지 않고 eGov 부모 POM 버전을 올려서 받는다
          (5.0.2 의 Spring Boot 3.5.6 은 2026-06-30 오픈소스 지원 종료).
    -->
    <parent>
        <groupId>org.egovframe.boot</groupId>
        <artifactId>egovframe-boot-starter-parent</artifactId>
        <version>5.1.0</version>
        <relativePath/>
    </parent>

    <groupId>kr.go.daegu</groupId>
    <artifactId>daegu-pms</artifactId>
    <version>0.11.0-SNAPSHOT</version>
    <name>daegu-pms</name>
    <description>D-PMS 대구형 공공 R&amp;D·창업 지원사업 통합관리 및 e-정산 시스템 (eGovFrame 5.1)</description>

    <properties>
        <java.version>17</java.version>
        <poi.version>5.4.1</poi.version>
        <!-- 화면 라이브러리 버전 (WebJars) -->
        <bootstrap.version>5.3.3</bootstrap.version>
        <bootstrap-icons.version>1.11.3</bootstrap-icons.version>
        <!--
            Flyway: Spring Boot 3.5.16 이 정한 11.7.2 는 MySQL 8.1 까지만 검증 범위라
            CI 의 MySQL 8.4 에서 "Flyway upgrade recommended ... support has not been tested" 경고가 난다.
            같은 11.x 의 마지막 판(2026-01, MySQL 9.4 까지 검증)으로 올린다. Spring Boot 버전을 올릴 때 다시 확인
        -->
        <flyway.version>11.20.3</flyway.version>
    </properties>

    <repositories>
        <!-- 일반 오픈소스 라이브러리 -->
        <repository>
            <id>central</id>
            <url>https://repo1.maven.org/maven2/</url>
            <snapshots><enabled>false</enabled></snapshots>
        </repository>
        <!-- 전자정부 표준프레임워크 실행환경 라이브러리 (org.egovframe.*) -->
        <repository>
            <id>egovframe</id>
            <url>https://maven.egovframe.go.kr/maven/</url>
            <releases><enabled>true</enabled></releases>
            <snapshots><enabled>false</enabled></snapshots>
        </repository>
    </repositories>

    <dependencies>
        <!-- ===================== 전자정부 표준프레임워크 실행환경 ===================== -->
        <!-- 공통기반: EgovAbstractServiceImpl, 예외(BaseRuntimeException), 예외 후처리(ExceptionTransfer), LeaveaTrace -->
        <dependency>
            <groupId>org.egovframe.rte</groupId>
            <artifactId>egovframe-rte-fdl-cmmn</artifactId>
            <exclusions>
                <!-- fdl-logging 경유로 들어오는 JPA API 제외 (JPA 미사용) -->
                <exclusion>
                    <groupId>jakarta.persistence</groupId>
                    <artifactId>jakarta.persistence-api</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- ID Generation: EgovIdGnrService (테이블 기반 채번) -->
        <dependency>
            <groupId>org.egovframe.rte</groupId>
            <artifactId>egovframe-rte-fdl-idgnr</artifactId>
        </dependency>
        <!-- Property: EgovPropertyService -->
        <dependency>
            <groupId>org.egovframe.rte</groupId>
            <artifactId>egovframe-rte-fdl-property</artifactId>
            <exclusions>
                <!-- Spring 6 는 spring-jcl 을 사용하므로 중복 로깅 브리지 제거 -->
                <exclusion>
                    <groupId>commons-logging</groupId>
                    <artifactId>commons-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- Data Access: @EgovMapper, MyBatis 3 / MyBatis-Spring -->
        <dependency>
            <groupId>org.egovframe.rte</groupId>
            <artifactId>egovframe-rte-psl-dataaccess</artifactId>
            <exclusions>
                <!-- 2010년 개발 종료된 iBATIS 2 는 사용하지 않으므로 제외 (불필요한 라이브러리 = 공격 표면) -->
                <exclusion>
                    <groupId>org.apache.ibatis</groupId>
                    <artifactId>ibatis-sqlmap</artifactId>
                </exclusion>
                <!-- JPA 를 쓰지 않으므로 제외 (있으면 Hibernate Validator 가 JPA 구현체를 찾다 경고를 남김) -->
                <exclusion>
                    <groupId>jakarta.persistence</groupId>
                    <artifactId>jakarta.persistence-api</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- eGov 배치 (Spring Batch 5 기반). 공고 마감을 배치 잡으로 실행하고 실행 이력을 남긴다 (11차) -->
        <dependency>
            <groupId>org.egovframe.rte</groupId>
            <artifactId>egovframe-rte-bat-core</artifactId>
        </dependency>
        <!-- 암호화: EgovARIACryptoService(ARIA 국가표준 블록암호), EgovPasswordEncoder(키 검증) - 개인정보 컬럼 암호화 -->
        <dependency>
            <groupId>org.egovframe.boot</groupId>
            <artifactId>egovframe-boot-starter-crypto</artifactId>
        </dependency>
        <!-- MVC: PaginationInfo, PaginationRenderer -->
        <dependency>
            <groupId>org.egovframe.rte</groupId>
            <artifactId>egovframe-rte-ptl-mvc</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>commons-logging</groupId>
                    <artifactId>commons-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- ===================== Spring Boot ===================== -->
        <!--
            eGovFrame 실행환경은 로깅 구현체로 Log4j2 를 사용한다.
            모든 스타터가 공유하는 spring-boot-starter 에서 Logback(spring-boot-starter-logging)을 한 번만 제외하면
            프로젝트 전체에서 Logback 이 빠진다. (Logback 과 Log4j2 가 동시에 있으면 기동 시 충돌)
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-log4j2</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>
        <dependency>
            <groupId>org.thymeleaf.extras</groupId>
            <artifactId>thymeleaf-extras-springsecurity6</artifactId>
        </dependency>
        <!-- 공통 레이아웃(layout:decorate). 버전은 Spring Boot 가 관리 -->
        <dependency>
            <groupId>nz.net.ultraq.thymeleaf</groupId>
            <artifactId>thymeleaf-layout-dialect</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- DataSource(HikariCP) 자동 구성 + schema.sql/data.sql 초기화 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <!-- @Aspect 기반 AOP (eGov 선언적 트랜잭션·예외 후처리) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <!-- ===================== Database (MySQL 8.x) ===================== -->
        <!-- JDBC 드라이버. 버전은 Spring Boot 가 관리 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!--
            Flyway: 스키마 변경 이력 관리 (db/migration/V1__..., V2__... 를 순서대로 한 번씩 적용)
            서버가 뜰 때 아직 적용되지 않은 버전만 실행하고, 적용 기록은 flyway_schema_history 테이블에 남는다.
            MySQL 은 별도 모듈(flyway-mysql)이 있어야 인식한다.
        -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>

        <!-- ===================== 화면 정적 리소스 (WebJars) ===================== -->
        <!--
            외부 CDN 대신 JAR 로 포함해 /webjars/** 로 제공한다.
            - 인터넷이 막힌 행정망·내부망에서도 화면이 깨지지 않는다
            - CSP 를 script-src 'self' 로 좁힐 수 있다 (외부 스크립트 출처를 허용하지 않아도 됨)
            - 버전을 Maven 이 관리하므로 취약점 점검(의존성 검사) 대상에 함께 포함된다
        -->
        <!-- 화면에서 버전 없이 /webjars/bootstrap/... 로 참조 (버전은 이 pom.xml 에서만 관리) -->
        <dependency>
            <groupId>org.webjars</groupId>
            <artifactId>webjars-locator-lite</artifactId>
        </dependency>
        <dependency>
            <groupId>org.webjars.npm</groupId>
            <artifactId>bootstrap</artifactId>
            <version>${bootstrap.version}</version>
        </dependency>
        <dependency>
            <groupId>org.webjars.npm</groupId>
            <artifactId>bootstrap-icons</artifactId>
            <version>${bootstrap-icons.version}</version>
        </dependency>
        <!-- 메인 화면 분야별 예산은 도넛 차트(Chart.js) 대신 HTML 막대 목록으로 그린다 (7차 스프린트에서 의존성 제거) -->

        <!-- ===================== Excel ===================== -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>${poi.version}</version>
        </dependency>

        <!-- ===================== Utilities ===================== -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ===================== Test ===================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>${java.version}</release>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </path>
                        <path>
                            <groupId>org.springframework.boot</groupId>
                            <artifactId>spring-boot-configuration-processor</artifactId>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <!-- 테스트 JVM 인코딩 고정 (한글 Windows 기본 MS949 대응) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>-Dfile.encoding=UTF-8</argLine>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <jvmArguments>-Dfile.encoding=UTF-8</jvmArguments>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
